# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Java & XML (Spring Boot backend)
[*.{java,xml}]
indent_size = 4

# Frontend Vue, TypeScript, JavaScript, CSS, HTML
[*.{vue,ts,js,jsx,tsx,css,scss,html}]
indent_size = 2

# Configuration & Data files
[*.{json,yml,yaml,md}]
indent_size = 2

# Batch scripts & PowerShell (Windows compatibility)
[*.{cmd,bat,ps1}]
end_of_line = crlf
indent_size = 4

